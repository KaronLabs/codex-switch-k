#!/usr/bin/env bash
set -euo pipefail

repo=$(git rev-parse --show-toplevel) || exit 2
cd -- "$repo"

while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [[ $local_oid =~ ^0+$ ]] && continue
  if [[ $(git cat-file -t "$local_oid" 2>/dev/null || true) != commit ]]; then
    echo 'pre-push: unsupported object type' >&2
    exit 1
  fi
  if ! git rev-list --all 2>/dev/null | grep -Fx -- "$local_oid" >/dev/null; then
    echo 'pre-push: commit outside local refs' >&2
    exit 1
  fi
done

if [[ -e .gitleaks.toml || -L .gitleaks.toml || -e .gitleaksignore || -L .gitleaksignore
      || -n ${GITLEAKS_CONFIG+x} || -n ${GITLEAKS_CONFIG_TOML+x}
      || -n ${GITLEAKS_BIN+x} ]]; then
  echo 'pre-push: Gitleaks configuration override is not allowed' >&2
  exit 1
fi

if python3 --version >/dev/null 2>&1; then
  python_bin=python3
elif python --version >/dev/null 2>&1; then
  python_bin=python
else
  echo 'pre-push: Python is required' >&2
  exit 2
fi

if ! "$python_bin" scripts/check_public_history.py >/dev/null 2>&1; then
  echo 'pre-push: public Git history path check failed' >&2
  exit 1
fi

if [[ -x .githooks/tools/gitleaks ]]; then
  scanner=.githooks/tools/gitleaks
elif [[ -x .githooks/tools/gitleaks.exe ]]; then
  scanner=.githooks/tools/gitleaks.exe
elif command -v gitleaks >/dev/null 2>&1; then
  scanner=$(command -v gitleaks)
else
  echo 'pre-push: Gitleaks 8.30.1 is required' >&2
  exit 2
fi

if ! scanner_version=$("$scanner" version 2>/dev/null) || [[ $scanner_version != 8.30.1 ]]; then
  echo 'pre-push: expected Gitleaks 8.30.1' >&2
  exit 2
fi

if ! "$scanner" git . \
  --log-opts='--all --full-history --diff-merges=first-parent' \
  --redact=100 --max-archive-depth=2 --ignore-gitleaks-allow --no-banner \
  >/dev/null 2>&1; then
  echo 'pre-push: Gitleaks found a secret or could not scan; push blocked' >&2
  exit 1
fi

echo 'pre-push: public history and Gitleaks checks passed' >&2
