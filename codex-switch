#!/usr/bin/env bash
set -u

umask 077

ACCOUNT_ROOT=${CODEX_ACCOUNT_ROOT:-"$HOME/.local/share/codex-accounts"}
SHARED_HOME=${CODEX_SHARED_HOME:-"$HOME/.codex"}
CODEX_BIN=${CODEX_BIN:-"$HOME/.local/bin/codex"}
BWRAP_BIN=${BWRAP_BIN:-/usr/bin/bwrap}
SUDO_BIN=${SUDO_BIN:-/usr/bin/sudo}
ADMIN_RUNNER_BIN=${ADMIN_RUNNER_BIN:-/usr/local/libexec/codex-switch-admin-run}
PROC_ROOT=${CODEX_SWITCH_PROC_ROOT:-/proc}

readonly EX_USAGE=64
readonly EX_NOINPUT=66
readonly EX_UNAVAILABLE=75
readonly GATE_CANCELED=2
readonly SLOT_ERROR='account number must be a positive integer without leading zeros'

die() {
    printf '%s\n' "$1" >&2
    return "${2:-$EX_USAGE}"
}

valid_slot() {
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]]
}

slot_list() {
    local path slot
    [ ! -e "$ACCOUNT_ROOT" ] && [ ! -L "$ACCOUNT_ROOT" ] && return 0
    safe_home "$ACCOUNT_ROOT" || return 1
    for path in "$ACCOUNT_ROOT"/*; do
        slot=${path##*/}
        valid_slot "$slot" && printf '%s\n' "$slot"
    done | sort -n
}

require_slot() {
    local slot=$1
    valid_slot "$slot" || { die "$SLOT_ERROR" "$EX_USAGE"; return $?; }
    if [ ! -e "$ACCOUNT_ROOT/$slot" ] && [ ! -L "$ACCOUNT_ROOT/$slot" ]; then
        die "slot $slot does not exist; run codex-switch add $slot" "$EX_NOINPUT"
        return $?
    fi
}

require_file_auth_allowed() {
    python3 - <<'PY'
import pathlib
import sys
import tomllib

for path in (pathlib.Path('/etc/codex/requirements.toml'),
             pathlib.Path('/etc/codex/managed_config.toml')):
    try:
        with path.open('rb') as stream:
            policy = tomllib.load(stream)
    except FileNotFoundError:
        continue
    except (OSError, tomllib.TOMLDecodeError):
        print('unable to inspect managed Codex authentication policy', file=sys.stderr)
        sys.exit(1)
    if policy.get('cli_auth_credentials_store', 'file') != 'file':
        print('managed Codex policy prevents file-based slot authentication', file=sys.stderr)
        sys.exit(1)
PY
}

account_home() {
    printf '%s/%s/home\n' "$ACCOUNT_ROOT" "$1"
}

account_auth() {
    printf '%s/%s/auth.json\n' "$ACCOUNT_ROOT" "$1"
}

reject_symlink_components() {
    local path=$1 current part
    case "$path" in
        /*) current=/ ;;
        *) path=$PWD/$path; current=/ ;;
    esac
    IFS=/ read -r -a parts <<<"${path#/}"
    for part in "${parts[@]}"; do
        [ -n "$part" ] || continue
        if [ "$current" = / ]; then
            current="/$part"
        else
            current="$current/$part"
        fi
        [ ! -L "$current" ] || return 1
    done
    return 0
}

safe_home() {
    [ -d "$1" ] &&
        [ ! -L "$1" ] &&
        reject_symlink_components "$1" &&
        [ "$(stat -c '%u:%a' -- "$1" 2>/dev/null)" = "$(id -u):700" ]
}

safe_auth() {
    [ -f "$1" ] &&
        [ ! -L "$1" ] &&
        reject_symlink_components "$1" &&
        [ "$(stat -c '%u:%a' -- "$1" 2>/dev/null)" = "$(id -u):600" ]
}

validate_auth() {
    safe_auth "$1" || return 1
    jq -e '
        type == "object" and
        (.auth_mode == "chatgpt") and
        (.tokens | type == "object") and
        (.tokens.access_token | type == "string" and length > 0) and
        (.tokens.refresh_token | type == "string" and length > 0) and
        (.tokens.id_token | type == "string" and length > 0) and
        (.tokens.account_id | type == "string" and length > 0)
    ' "$1" >/dev/null 2>&1
}

account_is_unique() {
    local slot=$1 auth current_id other other_auth other_id slots
    auth=$(account_auth "$slot")
    validate_auth "$auth" || return 1
    current_id=$(jq -r '.tokens.account_id' "$auth") || return 1
    slots=$(slot_list) || return 1
    while IFS= read -r other; do
        [ -n "$other" ] || continue
        [ "$other" = "$slot" ] && continue
        other_auth=$(account_auth "$other")
        validate_auth "$other_auth" || continue
        other_id=$(jq -r '.tokens.account_id' "$other_auth") || return 1
        [ "$other_id" != "$current_id" ] || return 1
    done <<<"$slots"
    return 0
}

